{
  "mcpServers": {
    "northbeam": {
      "command": "python",
      "args": ["-m", "server.northbeam_mcp"],
      "env": {
        "NORTHBEAM_API_KEY": "${NORTHBEAM_API_KEY}",
        "NORTHBEAM_CLIENT_ID": "${NORTHBEAM_CLIENT_ID}",
        "NORTHBEAM_API_ENV": "${NORTHBEAM_API_ENV:-prod}"
      }
    }
  }
}
