{
  "mcpServers": {
    "northbeam": {
      "command": "uv",
      "args": ["run", "python", "-m", "server.northbeam_mcp"],
      "cwd": "${CLAUDE_PLUGIN_ROOT}",
      "env": {
        "NORTHBEAM_API_KEY": "${user_config.NORTHBEAM_API_KEY}",
        "NORTHBEAM_CLIENT_ID": "${user_config.NORTHBEAM_CLIENT_ID}",
        "NORTHBEAM_API_ENV": "${user_config.NORTHBEAM_API_ENV}"
      }
    }
  }
}
